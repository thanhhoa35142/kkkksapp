<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Dev API is plain HTTP on localhost/LAN -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Pickhour uses your location to show nearby picnic spots and the best time to visit.</string>
    <!-- macOS reads this key for the location prompt. -->
    <key>NSLocationUsageDescription</key>
    <string>Pickhour uses your location to show nearby picnic spots and the best time to visit.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    <!-- pickhour://spot/<uuid> — widget taps and notification routing. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>pickhour</string>
            </array>
        </dict>
    </array>
    <!-- Share page host: shared links are <ShareBaseURL>/s/<spotId>. Must match
         the applinks: domain in the entitlements. Empty = share Apple Maps links. -->
    <key>ShareBaseURL</key>
    <string>https://pickhour.app</string>
    <key>APIBaseURL</key>
    <string>http://localhost:8080</string>
</dict>
</plist>
