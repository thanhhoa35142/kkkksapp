    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickhour uses your location to show nearby picnic spots and the best time to visit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickhour gebruikt je locatie om picknickplekken in de buurt en het beste moment om te gaan te tonen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickhour verwendet deinen Standort, um Picknickplätze in der Nähe und die beste Zeit für einen Besuch zu zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pickhour usa tu ubicación para mostrar sitios de pícnic cercanos y el mejor momento para ir."
          }
        }
      }
    },
