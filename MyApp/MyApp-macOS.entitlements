<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store requires the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outgoing HTTPS to the Pickhour API and Apple Maps tiles. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- "Near me" recommendations. -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <!-- macOS spells the APNs entitlement with the developer prefix. -->
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
    <!-- Shared with the PickhourWidget extension (Shared/WidgetBridge.swift). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.example.MyApp</string>
    </array>
    <!-- Universal links: https://pickhour.app/s/<spotId> opens the app
         (host must equal Info.plist ShareBaseURL). -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:pickhour.app</string>
    </array>
</dict>
</plist>
