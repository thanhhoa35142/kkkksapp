    "WHEN_IN_2_DAYS" : {
      "comment" : "Push notification text (server sends this key). Args are strings: scores, 24-hour HH:MM times in the place's time zone, or a place name. Keep the positional specifiers.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 2 Tagen, %1$@–%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 2 days, %1$@–%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de 2 días, %1$@–%2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over 2 dagen, %1$@–%2$@"
          }
        }
      }
