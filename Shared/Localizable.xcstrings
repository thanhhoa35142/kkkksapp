    "Crowd" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andrang"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gente"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drukte"
          }
        }
      }
    },
    "Crowd levels are estimated from the time of day, weather, holidays and reports from people nearby. They are not live data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Andrang wird aus Tageszeit, Wetter, Feiertagen und Meldungen von Leuten in der Nähe geschätzt. Das sind keine Live-Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La afluencia se calcula según la hora, el tiempo, los festivos y los avisos de gente cercana. No son datos en directo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drukte wordt geschat op basis van het tijdstip, het weer, feestdagen en meldingen van mensen in de buurt. Het zijn geen live gegevens."
          }
        }
      }
    },
    "Crowds" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andrang"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afluencia"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drukte"
          }
        }
      }
